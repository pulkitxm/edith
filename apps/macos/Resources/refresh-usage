#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v bun >/dev/null 2>&1; then
  NODE_DIR="$HOME/.nvm/versions/node"
  [ -d "$NODE_DIR" ] && export PATH="$NODE_DIR/$(ls "$NODE_DIR" 2>/dev/null | tail -1)/bin:$PATH"
fi

OUT_DIR="${1:-$PWD/data}"
mkdir -p "$OUT_DIR"
OUT="$OUT_DIR/usage.json"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

_now() { /usr/bin/perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || date +%s; }
_t0=$(_now)
_tlast=$_t0
_phase() {
  local n d
  n=$(_now)
  d=$(awk "BEGIN{printf \"%.2f\", $n-$_tlast}")
  _tlast=$n
  printf '  ▸ %-10s %-32s %6ss\n' "$1" "$2" "$d"
}
_total() { awk "BEGIN{printf \"%.2f\", $(_now)-$_t0}"; }

label_for() {
  case "$1" in
    cli) echo "Claude Code" ;;
    cowork) echo "Cowork" ;;
    cc-cloud) echo "Claude Code Cloud" ;;
    codex) echo "Codex" ;;
    opencode) echo "OpenCode" ;;
    amp) echo "Amp" ;;
    droid) echo "Droid" ;;
    gemini) echo "Gemini" ;;
    copilot) echo "Copilot" ;;
    *) echo "$1" ;;
  esac
}

NORM='
def dropSynthetic:
  map(select(.modelName != "<synthetic>"
    or (.inputTokens + .outputTokens + .cacheCreationTokens + .cacheReadTokens + .cost) > 0));
def normDay:
  if (.modelBreakdowns | type) == "array" then
    { period: .date, breakdowns: [ .modelBreakdowns[] | {
        modelName: (.modelName // "unknown"),
        inputTokens: (.inputTokens // 0),
        outputTokens: ((.outputTokens // 0) + (.reasoningOutputTokens // 0)),
        cacheCreationTokens: (.cacheCreationTokens // 0),
        cacheReadTokens: (.cacheReadTokens // 0),
        cost: (.cost // .costUSD // 0)
      } ] }
  elif (.models | type) == "object" then
    (.costUSD // .totalCost // 0) as $cost
    | [ .models | to_entries[] | . + { tok: ((.value.inputTokens // 0) + (.value.outputTokens // 0) + (.value.reasoningOutputTokens // 0) + (.value.cacheCreationTokens // 0) + (.value.cacheReadTokens // 0)) } ] as $m
    | ([ $m[].tok ] | add // 0) as $tot
    | { period: .date, breakdowns: [ $m[] | {
        modelName: .key,
        inputTokens: (.value.inputTokens // 0),
        outputTokens: ((.value.outputTokens // 0) + (.value.reasoningOutputTokens // 0)),
        cacheCreationTokens: (.value.cacheCreationTokens // 0),
        cacheReadTokens: (.value.cacheReadTokens // 0),
        cost: (if $tot > 0 then $cost * (.tok / $tot) else 0 end)
      } ] }
  else
    . as $d | (.modelsUsed // ["unknown"]) as $mu | ($mu | length) as $n
    | { period: .date, breakdowns: [ $mu[] | {
        modelName: .,
        inputTokens: (($d.inputTokens // 0) / $n),
        outputTokens: ((($d.outputTokens // 0) + ($d.reasoningOutputTokens // 0)) / $n),
        cacheCreationTokens: (($d.cacheCreationTokens // 0) / $n),
        cacheReadTokens: (($d.cacheReadTokens // 0) / $n),
        cost: (($d.totalCost // $d.costUSD // 0) / $n)
      } ] }
  end;
'

printf '\n  EDITH · refresh usage · %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
printf '  ────────────────────────────────────────────────────\n'

if command -v bun >/dev/null 2>&1; then
  CACHE="$HOME/Library/Application Support/Edith/.ccusage"
  mkdir -p "$CACHE"
  if [ ! -x "$CACHE/node_modules/.bin/ccusage" ]; then
    printf '  · installing ccusage (first run, ~15s)…\n'
    (cd "$CACHE" && bun add ccusage >/dev/null 2>&1)
    _phase "ccusage" "installed via bun"
  else
    _phase "ccusage" "cached"
  fi
  ccu() { bun "$CACHE/node_modules/.bin/ccusage" "$@"; }
elif command -v npx >/dev/null 2>&1; then
  _phase "ccusage" "via npx"
  ccu() { npx -y ccusage@latest "$@"; }
else
  printf '  ✖ need bun or npx on PATH to run ccusage\n' >&2
  exit 1
fi

: >"$TMP/manifest.jsonl"

add_source() {
  local src="$1" daily="$2" session="$3"
  local n
  n=$(jq '.daily | length' "$daily" 2>/dev/null || echo 0)
  if [ "${n:-0}" = "0" ] || [ -z "$n" ]; then return 1; fi
  jq -c "$NORM"' { source: $src, label: $label, norm: [ .daily[] | normDay | .breakdowns |= dropSynthetic ] }' \
    --arg src "$src" --arg label "$(label_for "$src")" "$daily" >>"$TMP/manifest.jsonl"
  jq -c '{ source: $src, sessions: [ (.sessions // [])[] | { id: (.sessionId // ""), source: $src } ] }' \
    --arg src "$src" "$session" >>"$TMP/sessions.jsonl"
  _phase "$src" "$n days"
  return 0
}

printf '  · discovering sources…\n'

CLI_CFG="$HOME/.claude"
CLAUDE_CONFIG_DIR="$CLI_CFG" ccu claude daily --json 2>/dev/null >"$TMP/cli.daily.json" || echo '{"daily":[]}' >"$TMP/cli.daily.json"
CLAUDE_CONFIG_DIR="$CLI_CFG" ccu claude session --json 2>/dev/null >"$TMP/cli.session.json" || echo '{"sessions":[]}' >"$TMP/cli.session.json"
add_source cli "$TMP/cli.daily.json" "$TMP/cli.session.json" || true

COWORK_CFG="$(find "$HOME/Library/Application Support/Claude/local-agent-mode-sessions" -maxdepth 2 -name .claude -type d 2>/dev/null | paste -sd, -)"
if [ -n "$COWORK_CFG" ]; then
  CLAUDE_CONFIG_DIR="$COWORK_CFG" ccu claude daily --json 2>/dev/null >"$TMP/cowork.daily.json" || echo '{"daily":[]}' >"$TMP/cowork.daily.json"
  CLAUDE_CONFIG_DIR="$COWORK_CFG" ccu claude session --json 2>/dev/null >"$TMP/cowork.session.json" || echo '{"sessions":[]}' >"$TMP/cowork.session.json"
  add_source cowork "$TMP/cowork.daily.json" "$TMP/cowork.session.json" || true
fi

for agent in codex opencode amp droid codebuff hermes pi goose kilo copilot gemini kimi qwen openclaw; do
  ccu "$agent" daily --json --offline 2>/dev/null >"$TMP/$agent.daily.json" || continue
  ccu "$agent" session --json --offline 2>/dev/null >"$TMP/$agent.session.json" || echo '{"sessions":[]}' >"$TMP/$agent.session.json"
  add_source "$agent" "$TMP/$agent.daily.json" "$TMP/$agent.session.json" || true
done

if [ ! -s "$TMP/manifest.jsonl" ]; then
  printf '  ✖ no usage found from any source\n' >&2
  exit 1
fi
[ -s "$TMP/sessions.jsonl" ] || : >"$TMP/sessions.jsonl"

printf '  · assembling usage.json…\n'
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
jq -s \
  --arg now "$NOW" \
  --slurpfile ss <(jq -s '.' "$TMP/sessions.jsonl") '
  . as $srcs
  | [ $srcs[].source ] as $sources
  | ( reduce $srcs[] as $s ({};
        reduce $s.norm[] as $day (.;
          .[$day.period][$s.source] = $day.breakdowns)) ) as $byDate
  | ( [ $byDate[] | .[] | .[] ] ) as $all
  | {
      schemaVersion: 2,
      generatedAt: $now,
      sources: $sources,
      defaultSources: $sources,
      sourceMeta: ( reduce $srcs[] as $s ({}; .[$s.source] = { label: $s.label, tool: $s.label }) ),
      totals: {
        cost: ([ $all[].cost ] | add // 0),
        tokens: ([ $all[] | (.inputTokens + .outputTokens + .cacheCreationTokens + .cacheReadTokens) ] | add // 0),
        inputTokens: ([ $all[].inputTokens ] | add // 0),
        outputTokens: ([ $all[].outputTokens ] | add // 0),
        cacheCreationTokens: ([ $all[].cacheCreationTokens ] | add // 0),
        cacheReadTokens: ([ $all[].cacheReadTokens ] | add // 0)
      },
      daily: ( $byDate | to_entries | sort_by(.key) | map({ period: .key, bySource: .value }) ),
      sessions: [ $ss[0][] | .sessions[] ]
    }
' "$TMP/manifest.jsonl" >"$TMP/usage.json"

mv "$TMP/usage.json" "$OUT"

PROJECTS_DIR="$HOME/.claude/projects"
if [ -d "$PROJECTS_DIR" ] && [ -s "$TMP/cli.daily.json" ]; then
  [ -s "$TMP/cowork.daily.json" ] || echo '{"daily":[]}' >"$TMP/cowork.daily.json"
  jq -c -s '
    (.[1].daily + .[0].daily) as $days
    | reduce ($days[]) as $d ({};
        reduce ($d.modelBreakdowns[]) as $m (.;
          ((($m.inputTokens // 0) + ($m.outputTokens // 0) + ($m.cacheCreationTokens // 0) + ($m.cacheReadTokens // 0))) as $t
          | .[$d.date][$m.modelName] = (if $t > 0 then ($m.cost // 0) / $t else 0 end)))
  ' "$TMP/cli.daily.json" "$TMP/cowork.daily.json" >"$TMP/rates.json"

  Z=$(date +%z)
  OFF=$((10#${Z:1:2} * 3600 + 10#${Z:3:2} * 60))
  [ "${Z:0:1}" = "-" ] && OFF=$((-OFF))

  echo "[]" >"$TMP/cloud.json"
  CLOUD_RAW="$(perl -e 'alarm 20; exec @ARGV' claude agents --json --all 2>/dev/null || true)"
  if [ -n "$CLOUD_RAW" ]; then
    printf '%s' "$CLOUD_RAW" \
      | jq -c '[.[] | select(.kind == "background" and .sessionId) | .sessionId] | unique' \
        >"$TMP/cloud.json" 2>/dev/null || echo "[]" >"$TMP/cloud.json"
  fi

  WALK='
    def usertext:
      (.message.content // "") as $c
      | (if ($c | type) == "string" then $c
         elif ($c | type) == "array" then
           ([ $c[] | select(type == "object" and .type == "text" and (.text | type == "string")) | .text ] | .[0] // "")
         else "" end)
      | gsub("^\\s+"; "") | gsub("\\s+$"; "");
    def wtof:
      (.cwd // "") as $c
      | (["/.claude/worktrees/", "/.cursor/worktrees/"] | map(select(. as $m | $c | contains($m))) | .[0]) as $m
      | if $m == null then null
        else ($c | split($m)[1] // "" | split("/") | map(select(. != "")) | .[0]) end;
    if .type == "ai-title" and ((.aiTitle // "") != "") and ((.sessionId // "") != "") then
      {t: "title", sid: .sessionId, title: (.aiTitle | tostring | gsub("^\\s+"; "") | gsub("\\s+$"; ""))}
    elif .type == "user" and ((.sessionId // "") != "") then
      usertext as $x
      | if $x != "" and ($x | startswith("<") | not)
        then {t: "text", sid: .sessionId, tms: (.timestamp // ""), text: $x[0:80]}
        else empty end
    elif .type == "assistant" and (.message.usage != null) then
      (.message.id // .requestId // "") as $id
      | if $id == "" then empty else
        (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $ep
        | ($ep + $off) as $loc
        | (.message.usage) as $u
        | ($u.input_tokens // 0) as $inp | ($u.output_tokens // 0) as $out
        | ($u.cache_creation_input_tokens // 0) as $cc | ($u.cache_read_input_tokens // 0) as $cr
        | { t: "rec", id: $id, date: ($loc | strftime("%Y-%m-%d")), hour: (($loc / 3600 | floor) % 24),
            ts: ($ep * 1000), model: (.message.model // "unknown"), cwd: (.cwd // ""), wt: wtof,
            sid: (.sessionId // ""), src: $src,
            inp: $inp, out: $out, cc: $cc, cr: $cr, tok: ($inp + $out + $cc + $cr) }
        end
    else empty end
  '

  : >"$TMP/walk.jsonl"
  WCACHE="$HOME/Library/Application Support/Edith/.walkcache"
  mkdir -p "$WCACHE"
  find "$WCACHE" -type f -mtime +45 -delete 2>/dev/null || true
  WVER=$(md5 -q -s "$WALK" 2>/dev/null || echo v1)
  walk_dir() {
    [ -d "$1" ] || return 0
    WALK_DIR="$1" WALK_SRC="$2" WALK_OFF="$OFF" WALK_VER="$WVER" \
      WALK_CACHE="$WCACHE" WALK_OUT="$TMP/walk.jsonl" WALK_PROG="$WALK" \
      perl -e '
      use File::Find;
      use Digest::MD5 qw(md5_hex);
      open(STDERR, ">", "/dev/null");
      my ($dir, $src, $off, $ver, $cache, $out, $prog) =
        @ENV{qw(WALK_DIR WALK_SRC WALK_OFF WALK_VER WALK_CACHE WALK_OUT WALK_PROG)};
      open(my $ofh, ">>", $out) or exit 0;
      my @files;
      find(sub { push @files, $File::Find::name if /\.jsonl$/ }, $dir);
      for my $f (@files) {
        my ($size, $mtime) = (stat($f))[7, 9];
        next unless defined $size;
        my $cf = "$cache/" . md5_hex("$f|$src");
        my $meta = "#$mtime $size $off $ver";
        if (open(my $ch, "<", $cf)) {
          my $first = <$ch> // "";
          chomp $first;
          if ($first eq $meta) {
            print {$ofh} $_ while <$ch>;
            close $ch;
            utime undef, undef, $cf;
            next;
          }
          close $ch;
        }
        open(my $cw, ">", "$cf.tmp") or next;
        print {$cw} "$meta\n";
        if (open(my $jq, "-|", "jq", "-c", "--argjson", "off", $off,
            "--arg", "src", $src, $prog, $f)) {
          while (<$jq>) { print {$cw} $_; print {$ofh} $_; }
          close $jq;
        }
        close $cw;
        rename "$cf.tmp", $cf;
      }
    ' 2>/dev/null || true
  }
  NFILES=$(find "$PROJECTS_DIR" -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ')
  printf '  · walking %s transcript files…\n' "$NFILES"
  walk_dir "$PROJECTS_DIR" cli
  if [ -n "${COWORK_CFG:-}" ]; then
    (
      IFS=','
      for c in $COWORK_CFG; do walk_dir "$c/projects" cowork; done
    )
  fi
  jq -c 'select(.t == "rec") | del(.t)' "$TMP/walk.jsonl" >"$TMP/records.jsonl"
  jq -s '
    [ .[] | select(.t != "rec") ]
    | (map(select(.t == "text")) | group_by(.sid) | map(sort_by(.tms)[0] | {key: .sid, value: .text}) | from_entries) as $tx
    | (map(select(.t == "title")) | group_by(.sid) | map({key: .[0].sid, value: .[-1].title}) | from_entries) as $ai
    | $tx + $ai
  ' "$TMP/walk.jsonl" >"$TMP/titles.json"
  _phase "walk" "$(wc -l <"$TMP/records.jsonl" | tr -d ' ') messages"

  jq -s --slurpfile r "$TMP/rates.json" \
    'unique_by(.id) | map(. + {cost: (.tok * (($r[0][.date][.model]) // 0))})' \
    "$TMP/records.jsonl" >"$TMP/recs.json"

  CWDMAP_CACHE="$HOME/Library/Application Support/Edith/.cwdmap.jsonl"
  touch "$CWDMAP_CACHE"
  jq -r '[.[].cwd] | unique | .[] | select(. != "")' "$TMP/recs.json" | sort >"$TMP/cwds.txt"
  jq -c --rawfile want "$TMP/cwds.txt" \
    '($want | split("\n") | map(select(. != "")) | map({(.): true}) | add // {}) as $W
     | select($W[.cwd])' \
    "$CWDMAP_CACHE" >"$TMP/cwdmap.jsonl" 2>/dev/null || : >"$TMP/cwdmap.jsonl"
  jq -r '.cwd' "$TMP/cwdmap.jsonl" | sort -u >"$TMP/cwds-have.txt"
  comm -23 "$TMP/cwds.txt" "$TMP/cwds-have.txt" | while IFS= read -r cwd; do
    name=""
    case "$cwd" in
      */local-agent-mode-sessions/*) name="Cowork" ;;
    esac
    if [ -z "$name" ] && [ -d "$cwd" ]; then
      common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
      if [ -n "$common" ]; then
        case "$common" in
          */.git) name=$(basename "${common%/.git}") ;;
          *)
            top=$(git -C "$cwd" rev-parse --path-format=absolute --show-toplevel 2>/dev/null || true)
            [ -n "$top" ] && name=$(basename "$top")
            ;;
        esac
      fi
    fi
    if [ -z "$name" ]; then
      for m in "/.claude/worktrees/" "/.cursor/worktrees/"; do
        case "$cwd" in
          *"$m"*)
            name=$(basename "${cwd%%"$m"*}")
            break
            ;;
        esac
      done
    fi
    [ -n "$name" ] || name=$(basename "$cwd")
    jq -cn --arg c "$cwd" --arg n "$name" '{cwd: $c, name: $n}' >>"$TMP/cwdmap.jsonl"
  done
  jq -c --rawfile have "$TMP/cwds-have.txt" \
    '($have | split("\n") | map(select(. != "")) | map({(.): true}) | add // {}) as $H
     | select($H[.cwd] | not)' \
    "$TMP/cwdmap.jsonl" >>"$CWDMAP_CACHE" 2>/dev/null || true
  _phase "projects" "$(wc -l <"$TMP/cwdmap.jsonl" | tr -d ' ') repos"

  jq \
    --slurpfile usage "$OUT" \
    --slurpfile titles "$TMP/titles.json" \
    --slurpfile cloud "$TMP/cloud.json" \
    --slurpfile nm <(jq -s 'map({(.cwd): .name}) | add // {}' "$TMP/cwdmap.jsonl") '
    . as $R | $usage[0] as $usage | ($nm[0] // {}) as $NAME | ($titles[0] // {}) as $T |
    (($cloud[0] // []) | map({(.): true}) | add // {}) as $CS |
    def chatsort: sort_by([-.tokens, .id]);
    ( $R | group_by(.date) | map({
        key: .[0].date,
        hours: ( group_by(.hour) | map({hour: .[0].hour, tokens: (map(.tok) | add), cost: (map(.cost) | add)}) ),
        projects: ( map(. + {p: ($NAME[.cwd] // "unknown")}) | group_by(.p)
          | map(
              ( group_by(.sid) | map(
                  ( group_by(.wt // "") | map({
                      wt: (.[0].wt // ""),
                      tokens: (map(.tok) | add), cost: (map(.cost) | add),
                      firstTs: (map(.ts) | min), lastTs: (map(.ts) | max)
                    }) ) as $frags
                  | ($frags | max_by(.tokens)) as $win
                  | { wt: $win.wt,
                      chat: {
                        id: .[0].sid,
                        title: ($T[.[0].sid]
                          // (if .[0].sid != "" then "Chat " + (.[0].sid[0:8]) else "Untitled chat" end)),
                        tokens: ($frags | map(.tokens) | add),
                        cost: ($frags | map(.cost) | add),
                        firstTs: ($frags | map(.firstTs) | min),
                        lastTs: ($frags | map(.lastTs) | max),
                        source: (if $CS[.[0].sid] then "cc-cloud" else .[0].src end)
                      } }
                ) ) as $chats
              | { projectName: .[0].p,
                  tokens: (map(.tok) | add), cost: (map(.cost) | add),
                  chats: ([ $chats[] | select(.wt == "") | .chat ] | chatsort),
                  worktrees: ([ $chats[] | select(.wt != "") ] | group_by(.wt) | map({
                      name: .[0].wt,
                      tokens: (map(.chat.tokens) | add), cost: (map(.chat.cost) | add),
                      chats: (map(.chat) | chatsort)
                    }) | sort_by([-.tokens, .name])) }
            )
          | sort_by([-.tokens, .projectName]) )
      }) | map({(.key): {hours: .hours, projects: .projects}}) | add // {} ) as $BY |
    $usage | .schemaVersion = 4 | .daily = [ .daily[] |
      ($BY[.period]) as $b |
      .hours = ( [range(0; 24)] | map( . as $h |
        ($b.hours // [] | map(select(.hour == $h)) | .[0]) as $x
        | {tokens: ($x.tokens // 0), cost: ($x.cost // 0)} ) )
      | .projects = ($b.projects // [])
    ]
  ' "$TMP/recs.json" >"$TMP/merged.json" && mv "$TMP/merged.json" "$OUT"
  _phase "merge" "hours + projects merged"

  NCLOUD=$(jq 'length' "$TMP/cloud.json" 2>/dev/null || echo 0)
  if [ "${NCLOUD:-0}" -gt 0 ]; then
    jq --slurpfile cloud "$TMP/cloud.json" '
      ($cloud[0] // [] | map({(.): true}) | add // {}) as $CS |
      [ .[] | select($CS[.sid]) | select(.model != "<synthetic>" or .tok > 0) ]
      | group_by(.date + "|" + .model)
      | map({ date: .[0].date, model: .[0].model,
              inputTokens: (map(.inp) | add), outputTokens: (map(.out) | add),
              cacheCreationTokens: (map(.cc) | add), cacheReadTokens: (map(.cr) | add),
              cost: (map(.cost) | add) })
      | reduce .[] as $x ({}; .[$x.date][$x.model] = $x)
    ' "$TMP/recs.json" >"$TMP/cloudagg.json"

    jq --slurpfile ca "$TMP/cloudagg.json" '
      ($ca[0] // {}) as $CA |
      .daily = [ .daily[] | . as $d | ($CA[$d.period] // {}) as $cm |
        if ($cm | length) == 0 then . else
          .bySource.cli = [ (.bySource.cli // [])[] | . as $b | ($cm[$b.modelName]) as $c |
            if $c == null then $b else
              $b
              | .inputTokens = ([(.inputTokens // 0) - $c.inputTokens, 0] | max)
              | .outputTokens = ([(.outputTokens // 0) - $c.outputTokens, 0] | max)
              | .cacheCreationTokens = ([(.cacheCreationTokens // 0) - $c.cacheCreationTokens, 0] | max)
              | .cacheReadTokens = ([(.cacheReadTokens // 0) - $c.cacheReadTokens, 0] | max)
              | .cost = ([(.cost // 0) - $c.cost, 0] | max)
            end ]
          | .bySource["cc-cloud"] = [ $cm | to_entries[] | .value
              | {modelName: .model, inputTokens, outputTokens, cacheCreationTokens, cacheReadTokens, cost} ]
        end
      ]
      | if (.daily | map(.bySource | has("cc-cloud")) | any) then
          .sources = ((.sources // []) + (["cc-cloud"] - (.sources // [])))
          | .defaultSources = ((.defaultSources // []) + (["cc-cloud"] - (.defaultSources // [])))
          | .sourceMeta += {"cc-cloud": {label: "Claude Code Cloud", tool: "Claude Code Cloud"}}
        else . end
      | ([.daily[].bySource[][]]) as $all
      | .totals = {
          cost: ([$all[].cost] | add // 0),
          tokens: ([$all[] | ((.inputTokens // 0) + (.outputTokens // 0) + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0))] | add // 0),
          inputTokens: ([$all[].inputTokens] | add // 0),
          outputTokens: ([$all[].outputTokens] | add // 0),
          cacheCreationTokens: ([$all[].cacheCreationTokens] | add // 0),
          cacheReadTokens: ([$all[].cacheReadTokens] | add // 0)
        }
    ' "$OUT" >"$TMP/split.json" && mv "$TMP/split.json" "$OUT"
    _phase "cc-cloud" "$NCLOUD cloud sessions split out"
  fi
fi

DAYS=$(jq '.daily | length' "$OUT")
SESS=$(jq '.sessions | length' "$OUT")
SRCS=$(jq -r '.sources | join(", ")' "$OUT")
MODELS=$(jq '[.daily[].bySource[][].modelName] | unique | length' "$OUT")
FROM=$(jq -r '.daily[0].period // "-"' "$OUT")
TO=$(jq -r '.daily[-1].period // "-"' "$OUT")
COST=$(printf '$%.2f' "$(jq -r '.totals.cost // 0' "$OUT")")
KB=$(awk "BEGIN{printf \"%.0f\", $(wc -c <"$OUT")/1024}")

printf '  ────────────────────────────────────────────────────\n'
printf '  ✓ sources   %s\n' "$SRCS"
