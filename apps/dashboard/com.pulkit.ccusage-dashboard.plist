<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pulkit.ccusage-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/pulkit/scripts/edith/apps/dashboard/cc-update</string>
        <string>--push</string>
    </array>

    <!-- run every day at 10:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/ccusage-dashboard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ccusage-dashboard.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
