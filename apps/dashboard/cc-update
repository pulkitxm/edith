#!/usr/bin/env bash
#
# cc-update - refresh the Claude Code usage dashboard.
#
#   1. pull the latest usage from ccusage  (CLI + Cowork, daily + session, JSON)
#   2. build dashboard.html from the modular sources (css/ + js/ via build.mjs)
#   3. assemble data/usage.json and inline it into dashboard.html
#   4. with --push only: commit + push to the private history repo (if changed)
#
# Refresh locally:       ./cc-update
# Refresh + publish:     ./cc-update --push
# Or on a schedule via:  launchctl start com.pulkit.ccusage-dashboard
#
set -euo pipefail

PUSH=0
[ "${1:-}" = "--push" ] && PUSH=1

# resolve repo dir = location of this script (works from any cwd / launchd)
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO"

# put bun / node / claude / biome on PATH for non-interactive launchd runs
export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v bun  >/dev/null 2>&1 || export PATH="$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node" 2>/dev/null | tail -1)/bin:$PATH"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# ---- timing: perl hi-res clock (always present on macOS, survives launchd's
# minimal PATH); whole-second `date` fallback. _phase prints one tidy line per
# step as "▸ <label>  <detail>  <elapsed>"; _total is wall-clock since start.
_now(){ /usr/bin/perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || date +%s; }
_t0=$(_now); _tlast=$_t0
_total(){ awk "BEGIN{printf \"%.2fs\", $(_now)-$_t0}"; }
# Must run in the current shell (not a subshell) so _tlast carries between phases.
_phase(){
  local n d; n=$(_now); d=$(awk "BEGIN{printf \"%.2f\", $n-$_tlast}"); _tlast=$n
  printf '▸ %-7s %-32s%6ss\n' "$1" "$2" "$d"
}

# Resolve ccusage ONCE up front. The four collection calls below run in parallel,
# but four concurrent `bunx ccusage@latest` processes race to link the package
# into bun's shared cache and collide ("Failed to link ccusage: EEXIST"). A single
# install into $TMP sidesteps the race and drops the per-call registry round-trip,
# so the parallel calls become pure read-only binary launches.
if [ -n "${CCUSAGE_CMD:-}" ]; then
  RUN="$CCUSAGE_CMD"                          # explicit override (e.g. global install)
else
  ( cd "$TMP" && bun add ccusage >/dev/null 2>&1 )
  RUN="bun $TMP/node_modules/.bin/ccusage"
fi

# Claude Code has two sources, each a comma-separated CLAUDE_CONFIG_DIR list:
#   cli    - the normal Claude Code CLI logs in ~/.claude
#   cowork - Cowork (local-agent mode) runs Claude Code under the hood and writes
#            the same JSONL nested under the desktop app; point ccusage at each.
# NB: we call `ccusage claude …`, NOT plain `ccusage daily`. ccusage 2.x sums
# EVERY detected agent by default, which would silently fold opencode/codex spend
# into the Claude Code totals. Each agent is collected on its own below instead.
CLI_CFG="$HOME/.claude"
COWORK_ROOT="$HOME/Library/Application Support/Claude/local-agent-mode-sessions"
COWORK_CFG="$(find "$COWORK_ROOT" -type d -path '*/.claude' 2>/dev/null | paste -sd, -)"

# Claude Code cli/cowork × daily/session - the core sources, collected
# concurrently (a single shared install means no per-call link race). The
# `wait $pid || exit` loop fails fast (set -e misses backgrounded failures).
CLAUDE_CONFIG_DIR="$CLI_CFG" $RUN claude daily   --json > "$TMP/daily.cli.json"   & p_dc=$!
CLAUDE_CONFIG_DIR="$CLI_CFG" $RUN claude session --json > "$TMP/session.cli.json" & p_sc=$!
if [ -n "$COWORK_CFG" ]; then
  CLAUDE_CONFIG_DIR="$COWORK_CFG" $RUN claude daily   --json > "$TMP/daily.cowork.json"   & p_dw=$!
  CLAUDE_CONFIG_DIR="$COWORK_CFG" $RUN claude session --json > "$TMP/session.cowork.json" & p_sw=$!
else
  p_dw=""; p_sw=""
fi
for pid in $p_dc $p_sc $p_dw $p_sw; do
  wait "$pid" || { echo "✗ ccusage (claude) collection failed" >&2; exit 1; }
done

# Every other agent ccusage knows about (Cursor isn't one - it keeps no local
# cost data). Probe each agent's daily SERIALLY with --offline, keep the ones
# with rows, and fetch their sessions. Why serial + offline (not the old parallel
# fan-out): 14 concurrent `ccusage` processes intermittently race its shared
# pricing cache and emit an empty `{"daily":[]}` - silently dropping an agent that
# actually has data (reproduced with codex/opencode on ccusage 20.x). Serial costs
# ~a few seconds but is deterministic; --offline uses ccusage's bundled pricing so
# a flaky network fetch can't blank an agent either. A genuinely empty agent is
# still just skipped, never fatal.
OTHER_AGENTS="codex opencode amp droid codebuff hermes pi goose kilo copilot gemini kimi qwen openclaw"
INCLUDED=""
# NB: process.stdout.write, not console.log - bun colorizes console.log numbers
# (wraps them in ANSI codes) even when piped, which silently breaks the numeric
# `[ "$rows" -gt 0 ]` test below and would skip every agent.
agent_rows(){ bun -e "process.stdout.write(String((require('$TMP/daily.$1.json').daily||[]).length))" 2>/dev/null || echo 0; }
for a in $OTHER_AGENTS; do
  $RUN "$a" daily --json --offline > "$TMP/daily.$a.json" 2>/dev/null || true
  rows=$(agent_rows "$a")
  [ "$rows" -gt 0 ] 2>/dev/null || continue
  $RUN "$a" session --json --offline > "$TMP/session.$a.json" 2>/dev/null &
  INCLUDED="${INCLUDED:+$INCLUDED }$a"
done
wait

# Assemble the render manifest (bun handles JSON-escaping paths that contain
# spaces, e.g. the Cowork "Application Support" dirs).
TMP="$TMP" CLI_CFG="$CLI_CFG" COWORK_CFG="$COWORK_CFG" INCLUDED="$INCLUDED" bun -e '
  const fs = require("fs");
  const { TMP, CLI_CFG, COWORK_CFG, INCLUDED } = process.env;
  const inc = (INCLUDED || "").trim().split(/\s+/).filter(Boolean);
  const m = [{ source:"cli", daily:`${TMP}/daily.cli.json`, session:`${TMP}/session.cli.json`, configDirs:CLI_CFG }];
  if (COWORK_CFG) m.push({ source:"cowork", daily:`${TMP}/daily.cowork.json`, session:`${TMP}/session.cowork.json`, configDirs:COWORK_CFG });
  for (const a of inc) m.push({ source:a, daily:`${TMP}/daily.${a}.json`, session:`${TMP}/session.${a}.json`, configDirs:"" });
  fs.writeFileSync(`${TMP}/manifest.json`, JSON.stringify(m));
'

collect_detail="$(printf '%s' "cli${COWORK_CFG:+ cowork} $INCLUDED" | sed 's/^ *//; s/ *$//; s/  */, /g')"
_phase collect "$collect_detail"

# Cloud (background/remote) Claude Code sessions run on Anthropic infra but sync
# their transcripts into ~/.claude, so ccusage folds them into the cli totals.
# Dump their session ids so render.mjs can split them out as the "Claude Code
# Cloud" source. Best-effort + time-bounded (perl alarm): a missing/old claude
# CLI, an offline run, or a slow sessions API just yields no split, never fails
# the update. Empty list ([]) → render keeps the combined Claude Code source.
echo "[]" > "$TMP/cloud-sessions.json"
CLOUD_RAW="$(perl -e 'alarm 20; exec @ARGV' claude agents --json --all 2>/dev/null || true)"
if [ -n "$CLOUD_RAW" ]; then
  printf '%s' "$CLOUD_RAW" | CLOUD_OUT="$TMP/cloud-sessions.json" bun -e '
    let a = []; try { a = JSON.parse(require("fs").readFileSync(0, "utf8")); } catch {}
    const ids = [...new Set((Array.isArray(a) ? a : [])
      .filter((s) => s && s.kind === "background" && s.sessionId).map((s) => s.sessionId))];
    require("fs").writeFileSync(process.env.CLOUD_OUT, JSON.stringify(ids));
  ' 2>/dev/null || echo "[]" > "$TMP/cloud-sessions.json"
fi
_phase cloud "$(F="$TMP/cloud-sessions.json" bun -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(process.env.F,"utf8")).length+" sessions")' 2>/dev/null || echo "0 sessions")"

# Format the hand-edited sources (js/, css/, build.mjs - see biome.json) before
# bundling, so style drift never shows up as noise in the commit diff.
format_out=$(biome format --write . 2>&1) || { echo "$format_out" >&2; exit 1; }
_phase format "$(printf '%s' "$format_out" | grep -oE 'Fixed [0-9]+ files?' || echo "no changes")"

# Regenerate the self-contained dashboard.html from css/ + js/ modules. Run before
# render.mjs: build.mjs preserves the existing <script id="usage-data"> block, then
# render.mjs writes the freshly-collected usage data into it. We capture each tool's
# one-line summary and fold the key fact into the phase line instead of echoing it.
build_out=$(bun "$REPO/build.mjs")
_phase build "$(printf '%s' "$build_out" | grep -oE '[0-9]+ KB' | tail -1)"

mkdir -p "$REPO/data"
# render.mjs reads the manifest (per-agent daily/session files + the Claude Code
# config-dir lists it uses to locate raw projects/**/*.jsonl for the drilldowns).
render_out=$(bun "$REPO/render.mjs" "$TMP/manifest.json" "$TMP/cloud-sessions.json")
r_days=$(printf '%s' "$render_out" | grep -oE '[0-9]+ days')
r_sess=$(printf '%s' "$render_out" | grep -oE '[0-9]+ sessions')
r_tot=$(printf '%s'  "$render_out" | grep -oE '\$[0-9,.]+ total' | grep -oE '\$[0-9,.]+')
_phase render "$r_days · $r_sess · $r_tot"

if [ "$PUSH" -ne 1 ]; then
  printf '✓ %s total · dashboard.html + data/usage.json updated\n' "$(_total)"
  echo "  push with ./cc-update --push"
  exit 0
fi

# data + the rebuilt artifact, plus the sources it was built from (so a code
# change that lands in dashboard.html is committed together with its source).
git add data/usage.json dashboard.html dashboard.template.html build.mjs css js biome.json
if git diff --cached --quiet; then
  printf '✓ %s total · no changes - already up to date\n' "$(_total)"
  exit 0
fi
git commit -q -m "usage: snapshot $(date '+%Y-%m-%d %H:%M')"

if git remote get-url origin >/dev/null 2>&1; then
  git push -q origin HEAD
  _phase push "$(git remote get-url origin)"
  printf '✅ %s total · pushed\n' "$(_total)"
else
  printf '✓ %s total · committed locally (no origin)\n' "$(_total)"
fi
