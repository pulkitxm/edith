diff --git a/vendor/ghostty/src/termio/External.zig b/src/termio/External.zig
new file mode 100644
index 00000000..568818ea
--- /dev/null
+++ b/src/termio/External.zig
@@ -0,0 +1,38 @@
+const std = @import("std");
+const renderer = @import("../renderer.zig");
+const External = @This();
+
+pub const Options = extern struct {
+    userdata: ?*anyopaque = null,
+    write: ?*const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void = null,
+    resize: ?*const fn (?*anyopaque, u16, u16, u32, u32) callconv(.c) void = null,
+};
+
+options: Options,
+stopped: std.atomic.Value(bool) = .init(false),
+
+pub fn init(options: Options) !External {
+    if (options.write == null or options.resize == null) return error.InvalidExternalIO;
+    return .{ .options = options };
+}
+
+pub fn resize(self: *External, grid: renderer.GridSize, screen: renderer.ScreenSize) void {
+    if (self.stopped.load(.acquire)) return;
+    self.options.resize.?(self.options.userdata, grid.columns, grid.rows, screen.width, screen.height);
+}
+
+pub fn queueWrite(self: *External, data: []const u8, linefeed: bool) void {
+    if (self.stopped.load(.acquire) or data.len == 0) return;
+    if (!linefeed) {
+        self.options.write.?(self.options.userdata, data.ptr, data.len);
+        return;
+    }
+    var start: usize = 0;
+    for (data, 0..) |byte, index| {
+        if (byte != '\r') continue;
+        if (index > start) self.options.write.?(self.options.userdata, data[start..index].ptr, index - start);
+        self.options.write.?(self.options.userdata, "\r\n", 2);
+        start = index + 1;
+    }
+    if (start < data.len) self.options.write.?(self.options.userdata, data[start..].ptr, data.len - start);
+}
diff --git a/vendor/ghostty/tests/external_io.m b/tests/external_io.m
new file mode 100644
index 00000000..4e47d092
--- /dev/null
+++ b/tests/external_io.m
@@ -0,0 +1,303 @@
+#import <AppKit/AppKit.h>
+#import <ghostty.h>
+#import <IOSurface/IOSurface.h>
+#import <QuartzCore/QuartzCore.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <util.h>
+
+static atomic_bool auditing;
+static atomic_uint process_calls;
+static atomic_uint pty_calls;
+static pid_t engine_pid = -1;
+static int engine_fd = -1;
+static pthread_mutex_t capture_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint8_t input_bytes[65536];
+static size_t input_count;
+static uint16_t resized_columns;
+static uint16_t resized_rows;
+static uint32_t resize_count;
+static bool closed_alive;
+static uint32_t close_count;
+
+static void require(bool passed, const char *message) {
+    if (passed) return;
+    fprintf(stderr, "failed: %s\n", message);
+    if (engine_pid > 0) {
+        kill(engine_pid, SIGKILL);
+        waitpid(engine_pid, NULL, 0);
+    }
+    exit(1);
+}
+
+pid_t fork(void) {
+    if (atomic_load(&auditing)) {
+        atomic_fetch_add(&process_calls, 1);
+        errno = EPERM;
+        return -1;
+    }
+    pid_t (*original)(void) = dlsym(RTLD_NEXT, "fork");
+    return original();
+}
+
+int posix_spawn(pid_t *pid, const char *path, const posix_spawn_file_actions_t *actions,
+                         const posix_spawnattr_t *attributes, char *const argv[], char *const env[]) {
+    if (atomic_load(&auditing)) {
+        atomic_fetch_add(&process_calls, 1);
+        return EPERM;
+    }
+    int (*original)(pid_t *, const char *, const posix_spawn_file_actions_t *,
+                    const posix_spawnattr_t *, char *const[], char *const[]) = dlsym(RTLD_NEXT, "posix_spawn");
+    return original(pid, path, actions, attributes, argv, env);
+}
+
+int posix_spawnp(pid_t *pid, const char *path, const posix_spawn_file_actions_t *actions,
+                          const posix_spawnattr_t *attributes, char *const argv[], char *const env[]) {
+    if (atomic_load(&auditing)) {
+        atomic_fetch_add(&process_calls, 1);
+        return EPERM;
+    }
+    int (*original)(pid_t *, const char *, const posix_spawn_file_actions_t *,
+                    const posix_spawnattr_t *, char *const[], char *const[]) = dlsym(RTLD_NEXT, "posix_spawnp");
+    return original(pid, path, actions, attributes, argv, env);
+}
+
+int openpty(int *master, int *slave, char *name, struct termios *attributes,
+                           struct winsize *size) {
+    if (atomic_load(&auditing)) {
+        atomic_fetch_add(&pty_calls, 1);
+        errno = EPERM;
+        return -1;
+    }
+    int (*original)(int *, int *, char *, struct termios *, struct winsize *) = dlsym(RTLD_NEXT, "openpty");
+    return original(master, slave, name, attributes, size);
+}
+
+static void wakeup(void *context) {}
+static bool action(ghostty_app_t app, ghostty_target_s target, ghostty_action_s value) { return false; }
+static ghostty_clipboard_read_result_e read_clipboard(void *context, ghostty_clipboard_e clipboard,
+                                                      void *state, const char *const *mimes,
+                                                      size_t count, bool list) {
+    return GHOSTTY_CLIPBOARD_READ_UNAVAILABLE;
+}
+static void confirm_clipboard(void *context, const ghostty_clipboard_confirm_s *confirmation,
+                              void *state, ghostty_clipboard_request_e request) {}
+static void write_clipboard(void *context, ghostty_clipboard_e clipboard,
+                            const ghostty_clipboard_content_s *contents, size_t count, bool confirm) {}
+static void close_surface(void *context, bool alive) {
+    close_count++;
+    closed_alive = alive;
+}
+
+static void send_input(void *context, const uint8_t *bytes, size_t count) {
+    pthread_mutex_lock(&capture_lock);
+    require(count <= sizeof(input_bytes) - input_count, "input capture bounded");
+    memcpy(input_bytes + input_count, bytes, count);
+    input_count += count;
+    if (engine_fd >= 0) require(write(engine_fd, bytes, count) == count, "engine input write");
+    pthread_mutex_unlock(&capture_lock);
+}
+
+static void resize_engine(void *context, uint16_t columns, uint16_t rows, uint32_t width, uint32_t height) {
+    pthread_mutex_lock(&capture_lock);
+    resized_columns = columns;
+    resized_rows = rows;
+    resize_count++;
+    if (engine_fd >= 0) {
+        struct winsize size = {.ws_col = columns, .ws_row = rows, .ws_xpixel = width, .ws_ypixel = height};
+        require(ioctl(engine_fd, TIOCSWINSZ, &size) == 0, "engine resize ioctl");
+    }
+    pthread_mutex_unlock(&capture_lock);
+}
+
+static NSString *surface_text(ghostty_surface_t surface) {
+    ghostty_selection_s selection = {
+        .top_left = {.tag = GHOSTTY_POINT_SCREEN, .coord = GHOSTTY_POINT_COORD_TOP_LEFT},
+        .bottom_right = {.tag = GHOSTTY_POINT_SCREEN, .coord = GHOSTTY_POINT_COORD_BOTTOM_RIGHT},
+    };
+    ghostty_text_s text = {0};
+    require(ghostty_surface_read_text(surface, selection, &text), "native screen text extraction");
+    NSString *value = [[NSString alloc] initWithBytes:text.text length:text.text_len encoding:NSUTF8StringEncoding];
+    ghostty_surface_free_text(surface, &text);
+    return value;
+}
+
+static void drain(ghostty_app_t app, ghostty_surface_t surface, unsigned iterations) {
+    for (unsigned index = 0; index < iterations; index++) {
+        uint8_t bytes[4096];
+        ssize_t count;
+        while (engine_fd >= 0 && (count = read(engine_fd, bytes, sizeof(bytes))) > 0) {
+            require(ghostty_surface_external_output(surface, bytes, count), "VT output accepted");
+        }
+        ghostty_app_tick(app);
+        usleep(10000);
+    }
+}
+
+static void wait_for_text(ghostty_app_t app, ghostty_surface_t surface, NSString *expected) {
+    for (unsigned attempt = 0; attempt < 300; attempt++) {
+        drain(app, surface, 1);
+        if ([surface_text(surface) containsString:expected]) return;
+    }
+    fprintf(stderr, "screen: %s\n", surface_text(surface).UTF8String);
+    require(false, "expected PTY output reached native VT parser");
+}
+
+int main(int argc, char **argv) {
+    @autoreleasepool {
+        int slave;
+        struct winsize initial_size = {.ws_col = 80, .ws_row = 24};
+        require(openpty(&engine_fd, &slave, NULL, NULL, &initial_size) == 0, "owned synthetic PTY");
+        struct termios attributes;
+        require(tcgetattr(slave, &attributes) == 0, "synthetic PTY attributes");
+        attributes.c_lflag &= ~ECHO;
+        require(tcsetattr(slave, TCSANOW, &attributes) == 0, "synthetic PTY echo disabled");
+        engine_pid = fork();
+        require(engine_pid >= 0, "owned synthetic engine child");
+        if (engine_pid == 0) {
+            alarm(15);
+            setsid();
+            ioctl(slave, TIOCSCTTY, 0);
+            dup2(slave, STDIN_FILENO);
+            dup2(slave, STDOUT_FILENO);
+            dup2(slave, STDERR_FILENO);
+            close(engine_fd);
+            close(slave);
+            execl("/bin/sh", "sh", "-c",
+                  "printf '\\033[2J\\033[H\\033[31mrenderer-fixture\\033[0m\\r\\n'; "
+                  "IFS= read -r line; printf 'input:%s\\r\\n' \"$line\"; stty size; "
+                  "printf '\\033[?1049halt-screen\\033[?1049l'; exit 7", NULL);
+            _exit(127);
+        }
+        close(slave);
+        require(fcntl(engine_fd, F_SETFL, O_NONBLOCK) == 0, "synthetic PTY nonblocking");
+        atomic_store(&auditing, true);
+        require(fork() == -1 && errno == EPERM, "process audit interposition active");
+        int denied_master, denied_slave;
+        require(openpty(&denied_master, &denied_slave, NULL, NULL, NULL) == -1 && errno == EPERM,
+                "PTY audit interposition active");
+        atomic_store(&process_calls, 0);
+        atomic_store(&pty_calls, 0);
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyProhibited];
+        require(ghostty_init(argc, argv) == 0, "pinned libghostty initialization");
+        ghostty_config_t config = ghostty_config_new();
+        require(config != NULL, "native config creation");
+        ghostty_config_finalize(config);
+        ghostty_runtime_config_s runtime = {
+            .wakeup_cb = wakeup, .action_cb = action, .read_clipboard_cb = read_clipboard,
+            .confirm_read_clipboard_cb = confirm_clipboard, .write_clipboard_cb = write_clipboard,
+            .close_surface_cb = close_surface,
+        };
+        ghostty_app_t app = ghostty_app_new(&runtime, config);
+        require(app != NULL, "native app creation");
+        NSView *view = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, 800, 600)];
+        ghostty_external_io_s io = {.write_cb = send_input, .resize_cb = resize_engine};
+        ghostty_surface_config_s options = ghostty_surface_config_new();
+        options.platform_tag = GHOSTTY_PLATFORM_MACOS;
+        options.platform.macos.nsview = (__bridge void *)view;
+        options.command = "/usr/bin/false";
+        options.external_io = &io;
+        ghostty_surface_t surface = ghostty_surface_new(app, &options);
+        require(surface != NULL, "process-free native surface creation");
+        [view setFrameSize:NSMakeSize(640, 400)];
+        ghostty_surface_set_size(surface, 640, 400);
+        drain(app, surface, 10);
+        require(ghostty_surface_foreground_pid(surface) == 0, "renderer owns no foreground process");
+        ghostty_string_s tty = ghostty_surface_tty_name(surface);
+        require(tty.len == 0, "renderer owns no tty");
+        ghostty_string_free(tty);
+        wait_for_text(app, surface, @"renderer-fixture");
+        ghostty_surface_size_s size = ghostty_surface_size(surface);
+        pthread_mutex_lock(&capture_lock);
+        require(resize_count > 0 && resized_columns == size.columns && resized_rows == size.rows,
+                "native dimensions reach engine resize callback");
+        pthread_mutex_unlock(&capture_lock);
+        require(size.columns > 0 && size.rows > 0, "native font grid dimensions");
+        ghostty_surface_request_close(surface);
+        require(close_count == 1, "user close delivered to owner");
+        ghostty_surface_text(surface, "synthetic-input\r", strlen("synthetic-input\r"));
+        wait_for_text(app, surface, @"input:synthetic-input");
+        wait_for_text(app, surface, [NSString stringWithFormat:@"%u %u", size.rows, size.columns]);
+        int status;
+        require(waitpid(engine_pid, &status, 0) == engine_pid, "owned engine exit reaped");
+        engine_pid = -1;
+        require(WIFEXITED(status) && WEXITSTATUS(status) == 7, "synthetic engine exact exit preserved");
+        drain(app, surface, 10);
+        close(engine_fd);
+        pthread_mutex_lock(&capture_lock);
+        engine_fd = -1;
+        input_count = 0;
+        pthread_mutex_unlock(&capture_lock);
+        require(![surface_text(surface) containsString:@"alt-screen"], "alternate screen restored");
+        const uint8_t output[] = "\033[2J\033[H\033[38;2;0;255;0mVT-state\033[0m\033[3;4H\033[6n";
+        for (size_t index = 0; index < sizeof(output) - 1; index++) {
+            require(ghostty_surface_external_output(surface, output + index, 1), "split VT sequence accepted");
+        }
+        drain(app, surface, 10);
+        require([surface_text(surface) containsString:@"VT-state"], "split VT cursor and SGR parsed");
+        ghostty_surface_draw(surface);
+        IOSurfaceRef frame = (__bridge IOSurfaceRef)view.layer.contents;
+        require(frame != NULL && CFGetTypeID(frame) == IOSurfaceGetTypeID(), "native Metal IOSurface rendered offscreen");
+        require(IOSurfaceGetWidth(frame) == 640 && IOSurfaceGetHeight(frame) == 400, "offscreen renderer dimensions");
+        require(IOSurfaceLock(frame, kIOSurfaceLockReadOnly, NULL) == kIOReturnSuccess, "offscreen pixels accessible");
+        const uint8_t *pixels = IOSurfaceGetBaseAddress(frame);
+        size_t stride = IOSurfaceGetBytesPerRow(frame);
+        size_t green_pixels = 0;
+        for (size_t row = 0; row < IOSurfaceGetHeight(frame); row++) {
+            for (size_t column = 0; column < IOSurfaceGetWidth(frame); column++) {
+                const uint8_t *pixel = pixels + row * stride + column * 4;
+                if (pixel[1] > pixel[0] + 20 && pixel[1] > pixel[2] + 20) green_pixels++;
+            }
+        }
+        IOSurfaceUnlock(frame, kIOSurfaceLockReadOnly, NULL);
+        require(green_pixels > 10, "original Metal renderer draws SGR green glyph pixels");
+        pthread_mutex_lock(&capture_lock);
+        require(input_count == 6 && memcmp(input_bytes, "\033[3;4R", 6) == 0, "VT DSR reply delivered to engine");
+        input_count = 0;
+        pthread_mutex_unlock(&capture_lock);
+        ghostty_surface_text(surface, "user-bytes", strlen("user-bytes"));
+        drain(app, surface, 10);
+        require(![surface_text(surface) containsString:@"user-bytes"], "input is not terminal output");
+        pthread_mutex_lock(&capture_lock);
+        require(input_count == 10 && memcmp(input_bytes, "user-bytes", 10) == 0, "input callback exact bytes");
+        input_count = 0;
+        pthread_mutex_unlock(&capture_lock);
+        pthread_mutex_lock(&capture_lock);
+        uint32_t resize_count_at_exit = resize_count;
+        pthread_mutex_unlock(&capture_lock);
+        require(ghostty_surface_external_exit(surface), "engine-driven exit accepted");
+        require(ghostty_surface_process_exited(surface), "native lifecycle marked exited");
+        require(!ghostty_surface_external_output(surface, output, sizeof(output) - 1), "stale output rejected");
+        require(!ghostty_surface_needs_confirm_quit(surface), "exited surface needs no process confirmation");
+        ghostty_surface_text(surface, "ignored", 7);
+        ghostty_surface_set_size(surface, 800, 600);
+        drain(app, surface, 10);
+        pthread_mutex_lock(&capture_lock);
+        require(input_count == 0, "exit suppresses queued input callbacks");
+        require(resize_count == resize_count_at_exit, "exit suppresses resize callbacks");
+        pthread_mutex_unlock(&capture_lock);
+        ghostty_surface_request_close(surface);
+        require(close_count >= 2 && !closed_alive, "exited close reaches owner without live process");
+        ghostty_surface_free(surface);
+        ghostty_app_free(app);
+        ghostty_config_free(config);
+        atomic_store(&auditing, false);
+        require(NSApp.windows.count == 0, "no visible or hidden windows created");
+        require(atomic_load(&process_calls) == 0 && atomic_load(&pty_calls) == 0,
+                "UI lifetime made zero child-process or PTY creation calls");
+        puts("external IO: native VT, real PTY input/resize, alternate screen, DSR, exit, stale output and process audit passed");
+        puts("renderer process creation calls: 0; renderer PTY creation calls: 0; visible windows: 0");
+    }
+    return 0;
+}
