{
  "schema": 1,
  "owner": "notchShelf",
  "reads": [
    {
      "name": "preferences",
      "root": "owner-home",
      "components": [
        "Library",
        "Preferences",
        {
          "derived": "engine-suite-plist"
        }
      ],
      "maximumBytes": 1048576,
      "format": "property-list",
      "selections": [
        {
          "name": "requireOption",
          "path": ["notchShelfRequireOption"],
          "codec": "value"
        }
      ]
    }
  ],
  "sentinels": [],
  "initial": {
    "preferences": {
      "requireOption": {
        "present": false
      }
    }
  },
  "final": {
    "preferences": {
      "requireOption": {
        "present": true,
        "value": true
      }
    }
  }
}
