{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "scripts/**",
      "apps/site/main.js",
      "apps/site/styles.css",
      "!**/.claude",
      "!extras"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "overrides": [
    {
      "includes": ["apps/site/styles.css"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" }
        }
      }
    }
  ]
}
